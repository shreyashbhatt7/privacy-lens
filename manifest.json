{
  "manifest_version": 3,
  "name": "Privacy Lens",
  "version": "0.1.0",
  "description": "Tracking forensics: see who is tracking you, how, and where the data goes.",
  "permissions": [
    "webRequest",
    "storage",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Privacy Lens"
  }
}

